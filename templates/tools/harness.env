# 하네스 설정. gate.sh와 hook이 읽는다. sh가 그대로 읽으므로 KEY="값" 꼴로 한 줄에 쓴다.
END_AT=""                # 과제 풀이가 끝나는 시각. 과제 시작 직후 채운다. 예: "13:00"
STOP_NEW_MIN="45"        # 남은 시간이 이보다 적으면 새 큰 작업을 시작하지 말라고 알린다. 작업별 시간 상한은 두지 않는다

TEST_ALL="python3 -m pytest -q"   # 전체 테스트. 비어 있으면 gate가 FAIL
TEST_DIR="tests"                  # 테스트 폴더
SRC_DIRS="app"                    # 코드 폴더. 줄 수 검사에 쓴다
CODE_GLOBS="*.py"                 # 줄 수 검사 대상 파일 이름. 스택이 다르면 바꾼다. 예: "*.ts *.tsx"
MAX_LINES="300"                   # 코드 파일 하나의 최대 줄 수
TEST_CONFIG="pytest.ini pyproject.toml setup.cfg conftest.py tests/conftest.py"   # 바뀌면 gate가 알린다
ASSERT_PATTERN="assert|==|!=|def test_"                         # 기존 테스트에서 이런 줄이 지워지거나 바뀌면 gate가 알린다
SKIP_PATTERN="skip|xfail"                                       # 기존 테스트에 이런 줄이 붙으면 gate가 알린다
